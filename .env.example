# ==============================================================================
# ZERO TRUST CLOUD STORAGE SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
APP_NAME="ZeroTrust File Vault"
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./zerotrust_storage.db

# Cryptographic & Authentication Secrets
# Generate a secure 32+ character key using: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Upload Policies
MAX_UPLOAD_SIZE_BYTES=104857600
ALLOWED_EXTENSIONS=pdf,docx,txt,png,jpg,jpeg,csv,json,zip,xlsx,pptx

# Storage Provider Configuration (local | s3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage_data

# Optional S3 Cloud Object Storage Settings (when STORAGE_PROVIDER=s3)
S3_BUCKET_NAME=your-bucket-name
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=us-east-1

# Zero Trust Security & Risk Thresholds
MAX_FAILED_LOGINS_BEFORE_LOCKOUT=5
LOCKOUT_DURATION_MINUTES=15
DOWNLOAD_RATE_LIMIT_PER_MINUTE=20
SUSPICIOUS_ACCESS_THRESHOLD_PER_HOUR=10

# CORS Allowed Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
